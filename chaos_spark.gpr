project Chaos_Spark is

   for Languages use ("Ada");

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   for Main use ("chaos_spark.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-O2",
         "-gnatwa",
         "-gnatVa",
         "-fstack-protector-strong");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use
        ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use
        ("-lcrypto",
         "-lm");
   end Linker;

end Chaos_Spark;
